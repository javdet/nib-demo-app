# Copy to .env to override the compose defaults. Everything here has a working
# default, so an empty .env is fine.

# Host ports
WEB_PORT=8080
API_PORT=8000
DB_PORT=5433

# Surfaced by /api/meta and shown in the footer
ENVIRONMENT=local-compose
APP_VERSION=0.1.0
GIT_SHA=dev

# Set to true to log every SQL statement from the dev backend
DB_ECHO=false
