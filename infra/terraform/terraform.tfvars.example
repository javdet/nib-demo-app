# Copy to terraform.tfvars to override. Every value below is already the
# default in variables.tf; this file exists to document the contract, not
# because the stack needs local overrides. Most values are also enforced by
# `validation` blocks and cannot be freely changed - see the comments in
# variables.tf for which ones and why.

aws_region      = "us-east-1"
environment     = "production"
resource_prefix = "nib-demo-prod"

vpc_cidr              = "10.20.0.0/16"
public_subnet_cidrs   = ["10.20.0.0/24", "10.20.1.0/24"]
private_subnet_cidrs  = ["10.20.10.0/24", "10.20.11.0/24"]
database_subnet_cidrs = ["10.20.20.0/24", "10.20.21.0/24"]

ecs_task_cpu      = 512
ecs_task_memory   = 1024
ecs_desired_count = 2

db_engine_version          = "16"
db_name                    = "nibshop"
db_username                = "nibapp"
db_instance_class          = "db.t4g.micro"
db_allocated_storage       = 20
db_max_allocated_storage   = 100
db_backup_retention_period = 7
